{
  "versione": "1.1.125",
  "build": "2026-07-06",
  "changelog": [
    {
      "versione": "1.1.125",
      "data": "2026-07-06",
      "modifiche": [
        "Sicurezza: corrette autorizzazioni su schede/sessioni/chat (un utente non può più toccare dati altrui)",
        "Reset password admin: ora genera una password temporanea casuale",
        "Migliorie minori di robustezza"
      ]
    },
    {
      "versione": "1.1.124",
      "data": "2026-07-06",
      "modifiche": [
        "Risolto il problema 'Token di accesso mancante' durante l'allenamento dopo un blocco schermo",
        "Sessione più stabile: niente più logout imprevisti; i progressi dell'allenamento restano salvati"
      ]
    },
    {
      "versione": "1.1.123",
      "data": "2026-06-20",
      "modifiche": [
        "Bot: corretto l'errore della creazione guidata quando scegli una parte del corpo",
        "Bot: menu comandi completo e testi aggiornati (si scrive, non si parla)"
      ]
    },
    {
      "versione": "1.1.122",
      "data": "2026-06-20",
      "modifiche": [
        "Bot Telegram: /guidata — crea una scheda scegliendo a pulsanti per categorie italiane",
        "Propone per primi i tuoi esercizi più usati"
      ]
    },
    {
      "versione": "1.1.121",
      "data": "2026-06-20",
      "modifiche": [
        "Bot Telegram: nuovo comando /statistiche con il riepilogo dei tuoi allenamenti"
      ]
    },
    {
      "versione": "1.1.120",
      "data": "2026-06-20",
      "modifiche": [
        "Bot Telegram: ricevi una notifica su Telegram quando ti scrivono in chat e non sei online",
        "(Richiede aver collegato Telegram dal Profilo)"
      ]
    },
    {
      "versione": "1.1.119",
      "data": "2026-06-20",
      "modifiche": [
        "Nuovo: Composizione corporea con storico (peso, grasso, muscolo, acqua, BMR, età metabolica…) e grafico andamento",
        "Profilo → 📊 Composizione corporea. Il tuo PT può aggiungere le misurazioni dal dettaglio cliente"
      ]
    },
    {
      "versione": "1.1.118",
      "data": "2026-06-20",
      "modifiche": [
        "Dashboard PT più professionale: azioni rapide, KPI ridisegnati e anteprima clienti con ultima attività",
        "Se non hai clienti, invito a condividere il profilo pubblico per acquisirli"
      ]
    },
    {
      "versione": "1.1.117",
      "data": "2026-06-19",
      "modifiche": [
        "Foto profilo: ora carichi una foto normale, la ritagli (zoom + trascina) e viene compressa in automatico",
        "Niente più limite di dimensione da gestire a mano"
      ]
    },
    {
      "versione": "1.1.116",
      "data": "2026-06-19",
      "modifiche": [
        "Admin Utenti: ora mostra ultima connessione, schede/sessioni, palestra e stato verifica email",
        "Avatar utente nella lista"
      ]
    },
    {
      "versione": "1.1.115",
      "data": "2026-06-19",
      "modifiche": [
        "Recupero password: link 'Password dimenticata?' nel login → ricevi un'email per reimpostarla",
        "Reset password sicuro con link a scadenza (1 ora)"
      ]
    },
    {
      "versione": "1.1.114",
      "data": "2026-06-19",
      "modifiche": [
        "Chat: lo stato online/offline ora è quello reale dell'altra persona (non più sempre online)",
        "Mostra 'visto' con l'ultimo accesso quando offline"
      ]
    },
    {
      "versione": "1.1.113",
      "data": "2026-06-19",
      "modifiche": [
        "Gestione Novità: campi Punti sistemati + selettore di emoji a griglia",
        "Admin: non puoi più bannare/declassare/eliminare il tuo stesso account"
      ]
    },
    {
      "versione": "1.1.112",
      "data": "2026-06-19",
      "modifiche": [
        "Onboarding dedicato per i Personal Trainer: bio, specializzazioni, esperienza, certificazioni, tariffe",
        "Il profilo pubblico del PT mostra ora le info professionali"
      ]
    },
    {
      "versione": "1.1.111",
      "data": "2026-06-19",
      "modifiche": [
        "Predisposta la verifica dell'email alla registrazione (si attiva quando configurata)",
        "Sicurezza account migliorata"
      ]
    },
    {
      "versione": "1.1.110",
      "data": "2026-06-19",
      "modifiche": [
        "Registrazione semplificata: l'account è attivo subito, niente attesa di approvazione",
        "Accesso automatico dopo la registrazione",
        "Il ruolo Personal Trainer resta soggetto ad approvazione"
      ]
    },
    {
      "versione": "1.1.109",
      "data": "2026-06-19",
      "modifiche": [
        "Ora puoi richiedere di diventare Personal Trainer dal tuo Profilo (anche dopo la registrazione)",
        "La richiesta arriva all'amministratore per l'approvazione"
      ]
    },
    {
      "versione": "1.1.108",
      "data": "2026-06-19",
      "modifiche": [
        "Ora puoi clonare una scheda pubblica (di un PT/admin) come tua copia personale modificabile",
        "Apri una scheda globale e tocca ⧉ Clona"
      ]
    },
    {
      "versione": "1.1.107",
      "data": "2026-06-19",
      "modifiche": [
        "Nuova pagina \"Trova un Personal Trainer\" con ricerca",
        "Dashboard: invito discreto a trovare un PT (solo se non ne hai uno)"
      ]
    },
    {
      "versione": "1.1.106",
      "data": "2026-06-19",
      "modifiche": [
        "Nuovo: profilo pubblico dei Personal Trainer (bio, statistiche, schede) — tocca un PT per vederlo",
        "Più facile valutare e iscriversi a un Personal Trainer"
      ]
    },
    {
      "versione": "1.1.105",
      "data": "2026-06-19",
      "modifiche": [
        "Fix importante: le spaziature (margini) ora funzionano in tutta l'app — un reset CSS le annullava ovunque",
        "Sezioni e card ora correttamente distanziate in Profilo, Statistiche e tutte le pagine"
      ]
    },
    {
      "versione": "1.1.104",
      "data": "2026-06-19",
      "modifiche": [
        "Profilo: più spazio tra le card in tutte le sezioni (non più attaccate)"
      ]
    },
    {
      "versione": "1.1.103",
      "data": "2026-06-19",
      "modifiche": [
        "Ombra delle card più morbida: niente più alone/intersezione tra riquadri vicini su sfondo scuro"
      ]
    },
    {
      "versione": "1.1.102",
      "data": "2026-06-19",
      "modifiche": [
        "Statistiche: KPI più distanziate tra loro e spaziatura sezioni leggermente ridotta (28px)"
      ]
    },
    {
      "versione": "1.1.101",
      "data": "2026-06-19",
      "modifiche": [
        "Statistiche: più spazio tra KPI e grafici e tra i grafici (32px, come la Dashboard)"
      ]
    },
    {
      "versione": "1.1.100",
      "data": "2026-06-19",
      "modifiche": [
        "Statistiche: spaziatura tra le sezioni uniformata",
        "Fix: modificando una scheda con cardio non si perdono più durata/velocità/inclinazione"
      ]
    },
    {
      "versione": "1.1.99",
      "data": "2026-06-18",
      "modifiche": [
        "Popup novità rifinito: tolta la X, barra di avanzamento nascosta con una sola novità, bottone d'azione più grande"
      ]
    },
    {
      "versione": "1.1.98",
