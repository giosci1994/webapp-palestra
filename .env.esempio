# ============================================
# GymMaster — Variabili d'Ambiente
# Copia questo file come .env e compila i valori.
# Le voci "facoltativo" possono restare vuote: la funzione resta spenta.
# ============================================

# --- Database PostgreSQL ---
POSTGRES_USER=gymmaster_utente
POSTGRES_PASSWORD=CAMBIA_QUESTA_PASSWORD_SICURA
POSTGRES_DB=gymmaster_db
DATABASE_URL=postgresql://gymmaster_utente:CAMBIA_QUESTA_PASSWORD_SICURA@db:5432/gymmaster_db

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT (Segreti) ---
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGRETO_ACCESS=CAMBIA_QUESTO_SEGRETO_ACCESS_32_CARATTERI
JWT_SEGRETO_REFRESH=CAMBIA_QUESTO_SEGRETO_REFRESH_32_CARATTERI
JWT_SCADENZA_ACCESS=15m
JWT_SCADENZA_REFRESH=7d

# --- Applicazione ---
PORTA_BACKEND=3000
AMBIENTE=produzione
# Indirizzo pubblico dell'app, senza / finale. Lo usano i link nelle email,
# le passkey (valgono solo su questo dominio) e le notifiche push.
APP_URL=https://gymmaster.example.com
# Dominio di base: serve solo se APP_URL manca (allora vale https://gymmaster.<DOMINIO>)
DOMINIO=example.com
# Da dove si puo' usare l'API, separati da virgola: l'indirizzo pubblico e,
# se serve, quello di casa (per esempio http://<ip-del-server>:6969)
ORIGINI_CONSENTITE=http://localhost:6969,https://gymmaster.example.com
# Dettaglio dei log del backend (facoltativo): debug, info, warn, error, silent.
# Senza: info in produzione, debug altrove.
LIVELLO_LOG=

# --- SuperAdmin Iniziale ---
# Creato al primo avvio, se non esiste
SUPERADMIN_EMAIL=admin@gymmaster.local
SUPERADMIN_PASSWORD=CAMBIA_QUESTA_PASSWORD_ADMIN
SUPERADMIN_NOME=Amministratore

# --- Google Gemini AI (facoltativo: assistente e bot che crea le schede) ---
# Ottieni la chiave da: https://aistudio.google.com/apikey
GEMINI_API_KEY=LA_TUA_API_KEY_GEMINI

# --- Bot Telegram (facoltativo: senza, non avviare il servizio "bot") ---
# Token del bot creato con @BotFather
TELEGRAM_BOT_TOKEN=IL_TUO_TOKEN_BOTFATHER
# Username del bot (senza @), usato per i deep link di collegamento
TELEGRAM_BOT_USERNAME=GymMasterBot
# Segreto condiviso bot <-> backend (rete interna).
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_SECRET=CAMBIA_QUESTO_SEGRETO_BOT

# --- Email (facoltativo: verifica dell'indirizzo e recupero password) ---
# Chiave di Resend (https://resend.com). Senza, nessuna email: la verifica
# dell'indirizzo resta spenta e la password la reimposta l'admin.
RESEND_API_KEY=
# Mittente delle email. Senza: GymMaster <onboarding@resend.dev>
EMAIL_MITTENTE=

# --- Notifiche push (facoltativo: Web Push) ---
# Coppia di chiavi VAPID: il server firma con queste le notifiche push.
# Genera con: cd backend && npx web-push generate-vapid-keys
# Senza, le notifiche push restano spente (il resto funziona).
VAPID_CHIAVE_PUBBLICA=
VAPID_CHIAVE_PRIVATA=
# Contatto per i servizi push (https: o mailto:). Senza: APP_URL
VAPID_CONTATTO=

# --- Scraper dell'affluenza (facoltativo) ---
# Proxy per le richieste a Google Maps, se dal server vengono bloccate
PROXY_URL=

# --- Rilasci automatici (deploy/rilascio.sh) ---
# Chat Telegram a cui il server scrive l'esito di ogni rilascio, con il bot
# di TELEGRAM_BOT_TOKEN. Se hai collegato Telegram dal Profilo il numero e' in
# collegamenti_telegram.telegram_chat_id; se no te lo dice @userinfobot.
# Vuoto: nessun messaggio.
RILASCI_TELEGRAM_CHAT_ID=
