# ============================================
# GymMaster — Environment variables
# Copy this file to .env and fill in the values.
# "Optional" entries can stay empty: that feature stays off.
# ============================================

# --- PostgreSQL database ---
POSTGRES_USER=gymmaster_utente
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=gymmaster_db
DATABASE_URL=postgresql://gymmaster_utente:CHANGE_THIS_SECURE_PASSWORD@db:5432/gymmaster_db

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- JWT (secrets) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SEGRETO_ACCESS=CHANGE_THIS_ACCESS_SECRET_32_CHARACTERS
JWT_SEGRETO_REFRESH=CHANGE_THIS_REFRESH_SECRET_32_CHARACTERS
JWT_SCADENZA_ACCESS=15m
JWT_SCADENZA_REFRESH=7d

# --- Application ---
PORTA_BACKEND=3000
# "produzione" (production) or "sviluppo" (development)
AMBIENTE=produzione
# Public address of the app, without a trailing /. Used by the links in
# emails, by passkeys (they only work on this domain) and by push notifications.
APP_URL=https://gymmaster.example.com
# Base domain: only needed when APP_URL is missing (then it is https://gymmaster.<DOMINIO>)
DOMINIO=example.com
# Where the API can be used from, comma-separated: the public address and,
# if needed, the one at home (for example http://<server-ip>:6969)
ORIGINI_CONSENTITE=http://localhost:6969,https://gymmaster.example.com
# Backend log level (optional): debug, info, warn, error, silent.
# Empty: info in production, debug otherwise.
LIVELLO_LOG=

# --- First SuperAdmin ---
# Created at the first start, if it does not exist
SUPERADMIN_EMAIL=admin@gymmaster.local
SUPERADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
SUPERADMIN_NOME=Administrator

# --- Google Gemini AI (optional: AI assistant and the bot that creates plans) ---
# Get the key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Telegram bot (optional: without it, do not start the "bot" service) ---
# Token of the bot created with @BotFather
TELEGRAM_BOT_TOKEN=YOUR_BOTFATHER_TOKEN
# Bot username (without @), used by the deep links that link an account
TELEGRAM_BOT_USERNAME=GymMasterBot
# Secret shared by bot and backend (internal network).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_SECRET=CHANGE_THIS_BOT_SECRET

# --- Email (optional: address verification and password recovery) ---
# Resend key (https://resend.com). Without it, no emails: address
# verification stays off and the admin resets passwords.
RESEND_API_KEY=
# Sender of the emails. Empty: GymMaster <onboarding@resend.dev>
EMAIL_MITTENTE=

# --- Push notifications (optional: Web Push) ---
# VAPID key pair: the server signs push notifications with it.
# Generate with: cd backend && npx web-push generate-vapid-keys
# Without it, push notifications stay off (everything else works).
VAPID_CHIAVE_PUBBLICA=
VAPID_CHIAVE_PRIVATA=
# Contact for the push services (https: or mailto:). Empty: APP_URL
VAPID_CONTATTO=

# --- Gym crowd scraper (optional) ---
# Proxy for the requests to Google Maps, if they get blocked from the server
PROXY_URL=

# --- Automatic releases (deploy/rilascio.sh) ---
# Telegram chat where the server reports the outcome of every release, using
# the bot of TELEGRAM_BOT_TOKEN. If you linked Telegram from the Profile page
# the number is in collegamenti_telegram.telegram_chat_id; otherwise
# @userinfobot tells you. Empty: no messages.
RILASCI_TELEGRAM_CHAT_ID=
