{
  "name": "gymmaster-backend",
  "version": "1.0.0",
  "description": "GymMaster PWA — Backend API REST con Express, Prisma e Socket.io",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node test/esegui.js",
    "test:unitari": "node test/esegui.js --solo-unitari",
    "seed": "node prisma/seed.js",
    "prisma:genera": "npx prisma generate",
    "prisma:migra": "npx prisma migrate deploy",
    "prisma:seed": "npx prisma db seed",
    "prisma:studio": "npx prisma studio",
    "prisma:reset": "npx prisma migrate reset --force"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@prisma/client": "^6.6.0",
    "@simplewebauthn/server": "^14.0.3",
    "argon2": "^0.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "9.7.1",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  }
}
