// ============================================
// GymMaster — Complete Prisma schema
// Database: PostgreSQL 17
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Ruolo {
  UTENTE
  PERSONAL_TRAINER
  SUPERADMIN
}

enum StatoUtente {
  IN_ATTESA
  ATTIVO
  BANNATO
}

enum CategoriaAttrezzatura {
  CARDIO
  PESI_LIBERI
  MACCHINE
  CAVI
  FUNZIONALE
}

enum Livello {
  BASE
  INTERMEDIO
  AVANZATO
}

enum Visibilita {
  GLOBALE
  PERSONALE
}

enum StatoRichiesta {
  IN_ATTESA
  ACCETTATA
  RIFIUTATA
  BLOCCATA
}

enum StatoSuggerimento {
  IN_ATTESA
  APPROVATO
  RIFIUTATO
}

enum TipoChat {
  PRIVATA
  PERSONAL_TRAINER
}

enum TipoNotifica {
  ALLENAMENTO_PIANIFICATO
  PROMEMORIA_ALLENAMENTO
  MESSAGGIO
  SCHEDA_ASSEGNATA
  RICHIESTA_PT
  SISTEMA
}

enum StatoAllenamentoPianificato {
  PIANIFICATO
  COMPLETATO
  SALTATO
}

enum StatoIscrizione {
  IN_ATTESA
  ATTIVA
  RIFIUTATA
  TERMINATA
}

// What kind of set it is: a work set (the ones in the plan), a warm-up set
// (before the work sets, left out of volume, counts, records and progression)
// or a drop set (right after a work set, with less weight: it counts towards
// volume, not as a set of its own)
enum TipoSerie {
  LAVORO
  RISCALDAMENTO
  DROP
}

// ============================================
// USERS & SECURITY
// ============================================

model Utente {
  id                Int         @id @default(autoincrement())
  email             String      @unique
  passwordHash      String      @map("password_hash")
  nome              String
  ruolo             Ruolo       @default(UTENTE)
  palestraId        Int?        @map("palestra_id")
  stato             StatoUtente @default(IN_ATTESA)
  puntiEsperienza   Int         @default(0) @map("punti_esperienza")
  dataRegistrazione DateTime    @default(now()) @map("data_registrazione")

  // Chat preferences
  chatRetentionGiorni Int @default(7) @map("chat_retention_giorni")

  // Extended profile
  immagineProfilo      String?   @map("immagine_profilo")      // Base64 avatar (max ~200KB)
  dataNascita          DateTime? @map("data_nascita")
  pesoKg               Float?    @map("peso_kg")
  altezzaCm            Int?      @map("altezza_cm")
  genere               String?                                 // "M", "F", "Altro"
  bio                  String?                                 // Short description
  obiettivoFitness     String?   @map("obiettivo_fitness")     // "Massa", "Definizione", etc.
  preferenzeVisibilita String?   @map("preferenze_visibilita") // JSON: {"palestra":true,...}
  lingua               String?                                 // App language chosen in Profile ("en", "it"); null follows the phone
  linguaApp            String?   @map("lingua_app")            // Language the app last used, for messages sent outside a request (push, reminders)
  fusoOrario           String?   @map("fuso_orario")           // Time zone of the phone the app last used ("Europe/Rome"): the user's days, weeks and reminder hour; null = the gym's

  // Onboarding & compliance
  profiloCompletato    Boolean   @default(false) @map("profilo_completato")
  gamificationAttiva   Boolean   @default(true)  @map("gamification_attiva")
  ruoloRichiesto       Ruolo?    @map("ruolo_richiesto")       // If they asked for a role change (e.g. PT)
  accettazioneToS      DateTime? @map("accettazione_tos")
  accettazionePrivacy  DateTime? @map("accettazione_privacy")
  consensoCookie       String?   @map("consenso_cookie")       // JSON: {"necessari":true,"analytics":false}

  // Email verification (on only if RESEND_API_KEY is set; default true so existing accounts are not locked out)
  emailVerificata       Boolean   @default(true)  @map("email_verificata")
  tokenVerificaEmail    String?   @map("token_verifica_email")
  tokenVerificaScadenza DateTime? @map("token_verifica_scadenza")

  // Personal trainer profile (filled in during the professional onboarding)
  specializzazioni     String?   @map("specializzazioni")     // JSON array of strings
  anniEsperienza       Int?      @map("anni_esperienza")
  certificazioni       String?   @map("certificazioni")
  contattoPubblico     String?   @map("contatto_pubblico")
  tariffaIndicativa    String?   @map("tariffa_indicativa")

  // Activity / presence
  ultimoAccesso        DateTime? @map("ultimo_accesso")

  // Password recovery
  tokenResetPassword   String?   @map("token_reset_password")
  tokenResetScadenza   DateTime? @map("token_reset_scadenza")

  // Progress reset (Option B)
  dataResetStatistiche   DateTime? @map("data_reset_statistiche")
  dataResetGamification  DateTime? @map("data_reset_gamification")

  // Relations
  palestra            Palestra?             @relation(fields: [palestraId], references: [id])
  recordPersonali     RecordPersonale[]
  misurazioni         MisurazioneCorporea[] @relation("MisurazioniUtente")
  schedeCreate        SchedaAllenamento[]   @relation("CreatoreSchede")
  sessioni            SessioneAllenamento[]
  refreshTokens       RefreshToken[]
  richiesteInviate    RichiestaContatto[]   @relation("RichiesteInviate")
  richiesteRicevute   RichiestaContatto[]   @relation("RichiesteRicevute")
  partecipazioni      PartecipanteChat[]
  messaggiInviati     Messaggio[]
  conversazioniAI     ConversazioneAI[]
  suggerimentiEsercizi SuggerimentoEsercizio[]

  // Personal trainer relations
  iscrizioniComeCliente IscrizionePT[]    @relation("IscrizioniUtente")
  clientiComePT         IscrizionePT[]    @relation("ClientiPT")
  appuntamentiTrainer   AppuntamentoPT[]  @relation("AppuntamentiPTTrainer")
  appuntamentiCliente   AppuntamentoPT[]  @relation("AppuntamentiPTCliente")
  annunciPT             AnnuncioPT[]      @relation("AnnunciPT")
  annunciRicevuti       AnnuncioPT[]      @relation("AnnunciDestinatario")
  schedeAssegnateDaPT   SchedaAllenamento[] @relation("SchedeAssegnatePT")

  // Telegram bot link
  collegamentoTelegram  CollegamentoTelegram?

  // Workout schedule
  allenamentiPianificati       AllenamentoPianificato[] @relation("AllenamentiPianificatiUtente")
  allenamentiPianificatiCreati AllenamentoPianificato[] @relation("AllenamentiPianificatiCreatore")

  // In-app notifications
  notifiche AllenamentoNotifica[]
  passkey   Passkey[]
  eserciziPreferiti EsercizioPreferito[]
  iscrizioniPush    IscrizionePush[]

  @@map("utenti")
}

// Exercises marked with the star: each user has their own, and they come first
// in searches
model EsercizioPreferito {
  utenteId    Int      @map("utente_id")
  esercizioId Int      @map("esercizio_id")
  creatoIl    DateTime @default(now()) @map("creato_il")

  utente    Utente    @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  esercizio Esercizio @relation(fields: [esercizioId], references: [id], onDelete: Cascade)

  @@id([utenteId, esercizioId])
  @@map("esercizi_preferiti")
}

// Passkey (WebAuthn): signing in with the device's fingerprint, face or PIN
// instead of the password. The private key stays on the device or in the
// password manager; only the public one is here, to verify signatures.
model Passkey {
  id             Int       @id @default(autoincrement())
  utenteId       Int       @map("utente_id")
  credenziale    String    @unique // Credential id, base64url
  chiavePubblica String    @map("chiave_pubblica") // COSE key, base64url
  contatore      Int       @default(0) // Signatures made: if it goes back, the passkey has been cloned
  trasporti      String? // JSON: ["internal", "hybrid"]
  sincronizzata  Boolean   @default(false) // Saved in the cloud (Google, iCloud): works on several devices
  nome           String? // "Chrome · Android": where it was added from
  creataIl       DateTime  @default(now()) @map("creata_il")
  ultimoUso      DateTime? @map("ultimo_uso")

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId])
  @@map("passkey")
}

// A device that receives push notifications (Web Push): the subscription the
// browser returns from pushManager.subscribe (services/push.service.js)
model IscrizionePush {
  id          Int      @id @default(autoincrement())
  utenteId    Int      @map("utente_id")
  endpoint    String   @unique
  p256dh      String
  auth        String
  dispositivo String? // "Chrome · Android", from the User-Agent
  creataIl    DateTime @default(now()) @map("creata_il")

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId])
  @@map("iscrizioni_push")
}

model RefreshToken {
  id                  Int       @id @default(autoincrement())
  token               String    @unique // SHA-256 fingerprint: only the client has the real token
  utenteId            Int       @map("utente_id")
  scadenza            DateTime
  creato              DateTime  @default(now()) // For the active token of a family: the last use
  revocato            Boolean   @default(false) // Replaced by the next one, or closed on suspected theft
  durataGiorni        Int       @default(7) @map("durata_giorni") // Original lifetime, carried over on refresh
  // A family is a session: the tokens born from the same login, rotation
  // after rotation, on one device
  famiglia            String
  dispositivo         String?   // "Chrome · Android", from the login User-Agent
  iniziataIl          DateTime  @default(now()) @map("iniziata_il") // Login time

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([famiglia])
  @@map("refresh_tokens")
}

// Link between a Utente account and a Telegram chat (for the bot).
// `codice` is a one-time token for the initial link.
model CollegamentoTelegram {
  id             Int       @id @default(autoincrement())
  utenteId       Int       @unique @map("utente_id")
  telegramChatId BigInt?   @unique @map("telegram_chat_id")
  codice         String?   @unique
  codiceScadenza DateTime? @map("codice_scadenza")
  collegatoIl    DateTime? @map("collegato_il")
  creatoIl       DateTime  @default(now()) @map("creato_il")

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@map("collegamenti_telegram")
}

// ============================================
// GYMS & EQUIPMENT
// ============================================

model Palestra {
  id              Int    @id @default(autoincrement())
  nomeCatena      String @map("nome_catena")
  citta           String
  indirizzo       String
  nazione         String @default("Italia")
  googlePlaceId   String? @map("google_place_id")

  utenti          Utente[]
  attrezzature    PalestraAttrezzatura[]
  affluenzaDati   AfluenzaPalestra[]

  @@map("palestre")
}

model AfluenzaPalestra {
  id                 Int      @id @default(autoincrement())
  palestraId         Int      @map("palestra_id")
  giornoSettimana    Int      @map("giorno_settimana") // 0=Mon, 6=Sun
  ora                Int                               // 0-23
  livelloPercentuale Int      @map("livello_percentuale") // 0-100 (historical pattern)
  liveLivello        Int?     @map("live_livello")     // 0-100 (real-time data)
  liveDescrizione    String?  @map("live_descrizione") // "Più affollata del solito" (busier than usual)
  aggiornatoIl       DateTime @default(now()) @map("aggiornato_il")

  palestra Palestra @relation(fields: [palestraId], references: [id], onDelete: Cascade)

  @@unique([palestraId, giornoSettimana, ora])
  @@map("affluenza_palestra")
}

model Attrezzatura {
  id               Int                   @id @default(autoincrement())
  nome             String
  categoria        CategoriaAttrezzatura
  muscoliBersaglio String?               @map("muscoli_bersaglio")

  palestre PalestraAttrezzatura[]
  esercizi Esercizio[]

  @@map("attrezzature")
}

model PalestraAttrezzatura {
  palestraId     Int @map("palestra_id")
  attrezzaturaId Int @map("attrezzatura_id")

  palestra     Palestra     @relation(fields: [palestraId], references: [id], onDelete: Cascade)
  attrezzatura Attrezzatura @relation(fields: [attrezzaturaId], references: [id], onDelete: Cascade)

  @@id([palestraId, attrezzaturaId])
  @@map("palestra_attrezzatura")
}

// ============================================
// EXERCISES & PLANS
// ============================================

model Esercizio {
  id                      Int     @id @default(autoincrement())
  nome                    String

  // Italian name, present only for entries imported with an English name.
  // The hand-curated catalogue (id <= 60) already has the Italian name in
  // `nome`, often with the English in brackets, and here it stays null.
  // The interface shows `nomeIt ?? nome`, with `nome` on a second line.
  nomeIt                  String? @map("nome_it")

  gruppoMuscoloPrimario   String  @map("gruppo_muscolare_primario")
  gruppoMuscoloSecondario String? @map("gruppo_muscolare_secondario")
  attrezzaturaRichiestaId Int?    @map("attrezzatura_richiesta_id")
  descrizione             String?
  linkVideo               String? @map("link_video")

  // Extra fields from the Functional Fitness v2.9 database
  difficulty              String?                                   // Principiante, Novizio, Intermedio, Avanzato, Esperto, Master, Gran Master, Leggendario
  bodyRegion              String? @map("body_region")               // Core, Parte Superiore, Parte Inferiore, Tutto il Corpo
  mechanics               String?                                   // Composto, Isolamento
  posture                 String?                                   // Supine, Prone, Standing, Seated, etc.
  movementPattern         String? @map("movement_pattern")          // Anti-Extension, Hip Extension, Horizontal Push, etc.
  laterality              String?                                   // Bilateral, Unilateral, Contralateral
  forceType               String? @map("force_type")                // Push, Pull, Other
  classification          String?                                   // Bodybuilding, Calisthenics, Postural, etc.

  attrezzatura    Attrezzatura?    @relation(fields: [attrezzaturaRichiestaId], references: [id])
  recordPersonali RecordPersonale[]
  eserciziScheda  EsercizioScheda[]
  logSerie        LogSerie[]
  suggerimenti    SuggerimentoEsercizio[]
  preferitoDa      EsercizioPreferito[]

  // Created by the 20260922_nome_italiano_esercizi migration: search uses
  // the Italian name too
  @@index([nomeIt])
  @@map("esercizi")
}

model SchedaAllenamento {
  id              Int        @id @default(autoincrement())
  creatoreId      Int        @map("creatore_id")
  titolo          String
  descrizione     String?
  livello         Livello    @default(BASE)
  visibilita      Visibilita @default(PERSONALE)
  assegnataDaPTId Int?       @map("assegnata_da_pt_id")
  creatoIl        DateTime   @default(now()) @map("creato_il")

  creatore      Utente            @relation("CreatoreSchede", fields: [creatoreId], references: [id])
  assegnataDaPT Utente?           @relation("SchedeAssegnatePT", fields: [assegnataDaPTId], references: [id])
  esercizi      EsercizioScheda[]
  sessioni      SessioneAllenamento[]
  pianificazioni AllenamentoPianificato[]

  @@map("schede_allenamento")
}

model EsercizioScheda {
  id               Int     @id @default(autoincrement())
  schedaId         Int     @map("scheda_id")
  esercizioId      Int     @map("esercizio_id")
  serieTarget      Int?    @map("serie_target")
  repTarget        String? @map("rep_target") // Range format: "8-12" (null for cardio)
  recuperoSecondi  Int?    @map("recupero_secondi")
  ordineEsecuzione Int     @map("ordine_esecuzione")

  // Technique cue for THIS exercise in THIS plan: posture corrections,
  // tempo, notes on one-sided execution. It lives here and not on the
  // exercise because it changes from plan to plan.
  note             String? @map("note")

  // Cardio targets (optional; used for cardio and warm-up entries)
  riscaldamento     Boolean @default(false)
  durataMinuti      Int?    @map("durata_minuti")
  velocitaKmh       Float?  @map("velocita_kmh")
  inclinazione      Float?
  livelloResistenza Int?    @map("livello_resistenza")
  distanzaKm        Float?  @map("distanza_km")

  scheda    SchedaAllenamento @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  esercizio Esercizio         @relation(fields: [esercizioId], references: [id])

  @@map("esercizi_scheda")
}

// ============================================
// TRACKING: WORKOUTS & LOG
// ============================================

model SessioneAllenamento {
  id                  Int       @id @default(autoincrement())
  utenteId            Int       @map("utente_id")
  // Empty for a free workout: two workouts merged into one, or done with a
  // plan that was then deleted. It keeps its sets, and its name in `titolo`
  schedaId            Int?      @map("scheda_id")
  titolo              String?
  dataInizio          DateTime  @map("data_inizio")
  dataFine            DateTime? @map("data_fine")
  durataMinuti        Int?      @map("durata_minuti")
  minutiRiscaldamento Int?      @map("minuti_riscaldamento")
  volumeTotaleKg      Float?    @map("volume_totale_kg")
  noteFinali          String?   @map("note_finali")
  // Closed by the server because it was forgotten open: it can be resumed
  // until the end of that day, not only for 30 minutes
  chiusaAutomaticamente Boolean @default(false) @map("chiusa_automaticamente")
  // When it was last resumed: it counts as activity, so the server does not
  // close it again right away as forgotten
  riapertaIl          DateTime? @map("riaperta_il")
  // An admin looked at it (Admin → Allenamenti da controllare) and it is fine:
  // it leaves that list
  controllataIl       DateTime? @map("controllata_il")

  utente   Utente              @relation(fields: [utenteId], references: [id])
  scheda   SchedaAllenamento?  @relation(fields: [schedaId], references: [id], onDelete: SetNull)
  logSerie LogSerie[]
  pianificazione AllenamentoPianificato?

  @@map("sessioni_allenamento")
}

model LogSerie {
  id                   Int     @id @default(autoincrement())
  sessioneId           Int     @map("sessione_id")
  esercizioId          Int     @map("esercizio_id")
  // Work sets are numbered 1, 2, 3...; warm-up has its own numbering; a drop
  // set carries the number of the work set it follows
  serieNumero          Int     @map("serie_numero")
  tipo                 TipoSerie @default(LAVORO)
  pesoEffettivo        Float   @map("peso_effettivo")
  repEffettive         Int     @map("rep_effettive")
  rpe                  Int?    // Rate of Perceived Exertion 1-10
  completato           Boolean @default(true)
  motivoSaltoEsercizio String? @map("motivo_salto_esercizio")
  noteSerie            String? @map("note_serie")
  // When it was logged: it tells when a workout left open ended
  // (services/conclusioneSessione.service.js). Empty for sets logged before
  // this column existed. A set done without a network brings it from the
  // phone: it is the time the set was done, not the time it arrived.
  registrataIl         DateTime? @default(now()) @map("registrata_il")
  // Chosen by the phone for each set: if the same set arrives twice (sent
  // without a network and then retried) it is logged only once
  idClient             String?   @map("id_client")

  // Optional fields for CARDIO
  distanzaKm           Float?  @map("distanza_km")
  durataMinuti         Int?    @map("durata_minuti")
  livelloResistenza    Int?    @map("livello_resistenza")
  velocitaKmh          Float?  @map("velocita_kmh")
  inclinazione         Float?  @map("inclinazione")

  sessione  SessioneAllenamento @relation(fields: [sessioneId], references: [id], onDelete: Cascade)
  esercizio Esercizio            @relation(fields: [esercizioId], references: [id])

  @@unique([sessioneId, idClient])
  @@map("log_serie")
}

model RecordPersonale {
  id               Int      @id @default(autoincrement())
  utenteId         Int      @map("utente_id")
  esercizioId      Int      @map("esercizio_id")
  pesoMaxRaggiunto Float    @map("peso_max_raggiunto")
  dataRecord       DateTime @default(now()) @map("data_record")

  utente    Utente    @relation(fields: [utenteId], references: [id])
  esercizio Esercizio @relation(fields: [esercizioId], references: [id])

  @@map("record_personali")
}

// ============================================
// EXERCISE SUGGESTIONS
// ============================================

model SuggerimentoEsercizio {
  id                      Int                @id @default(autoincrement())
  utenteId                Int                @map("utente_id")
  nome                    String
  gruppoMuscoloPrimario   String             @map("gruppo_muscolare_primario")
  gruppoMuscoloSecondario String?            @map("gruppo_muscolare_secondario")
  attrezzaturaSuggerita   String?            @map("attrezzatura_suggerita")
  descrizione             String?
  stato                   StatoSuggerimento  @default(IN_ATTESA)
  motivoRifiuto           String?            @map("motivo_rifiuto")
  esercizioCreato         Int?               @map("esercizio_creato_id")
  creatoIl                DateTime           @default(now()) @map("creato_il")
  gestitoIl               DateTime?          @map("gestito_il")

  utente    Utente     @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  esercizio Esercizio? @relation(fields: [esercizioCreato], references: [id])

  @@map("suggerimenti_esercizi")
}

// ============================================
// PERSONAL TRAINER
// ============================================

model IscrizionePT {
  id                  Int              @id @default(autoincrement())
  utenteId            Int              @map("utente_id")
  trainerId           Int              @map("trainer_id")
  stato               StatoIscrizione  @default(IN_ATTESA)
  messaggioRichiesta  String?          @map("messaggio_richiesta")
  dataRichiesta       DateTime         @default(now()) @map("data_richiesta")
  dataRisposta        DateTime?        @map("data_risposta")
  notePT              String?          @map("note_pt")

  utente  Utente @relation("IscrizioniUtente", fields: [utenteId], references: [id], onDelete: Cascade)
  trainer Utente @relation("ClientiPT", fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([utenteId, trainerId])
  @@map("iscrizioni_pt")
}

model AppuntamentoPT {
  id            Int      @id @default(autoincrement())
  trainerId     Int      @map("trainer_id")
  clienteId     Int      @map("cliente_id")
  titolo        String
  descrizione   String?
  dataOra       DateTime @map("data_ora")
  durataMinuti  Int      @default(60) @map("durata_minuti")
  completato    Boolean  @default(false)
  note          String?
  creatoIl      DateTime @default(now()) @map("creato_il")

  trainer Utente @relation("AppuntamentiPTTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  cliente Utente @relation("AppuntamentiPTCliente", fields: [clienteId], references: [id], onDelete: Cascade)

  @@map("appuntamenti_pt")
}

// ============================================
// CHAT & MESSAGING
// ============================================

model RichiestaContatto {
  id             Int            @id @default(autoincrement())
  mittenteId     Int            @map("mittente_id")
  destinatarioId Int            @map("destinatario_id")
  stato          StatoRichiesta @default(IN_ATTESA)
  dataRichiesta  DateTime       @default(now()) @map("data_richiesta")
  dataRisposta   DateTime?      @map("data_risposta")

  mittente     Utente @relation("RichiesteInviate", fields: [mittenteId], references: [id], onDelete: Cascade)
  destinatario Utente @relation("RichiesteRicevute", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@unique([mittenteId, destinatarioId])
  @@map("richieste_contatto")
}

model Conversazione {
  id       Int      @id @default(autoincrement())
  tipo     TipoChat @default(PRIVATA)
  creatoIl DateTime @default(now()) @map("creato_il")

  partecipanti PartecipanteChat[]
  messaggi     Messaggio[]

  @@map("conversazioni")
}

model PartecipanteChat {
  conversazioneId Int @map("conversazione_id")
  utenteId        Int @map("utente_id")

  conversazione Conversazione @relation(fields: [conversazioneId], references: [id], onDelete: Cascade)
  utente        Utente        @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@id([conversazioneId, utenteId])
  @@map("partecipanti_chat")
}

model Messaggio {
  id              Int      @id @default(autoincrement())
  conversazioneId Int      @map("conversazione_id")
  mittenteId      Int      @map("mittente_id")
  contenuto       String
  letto           Boolean  @default(false)
  inviatoIl       DateTime @default(now()) @map("inviato_il")

  conversazione Conversazione @relation(fields: [conversazioneId], references: [id], onDelete: Cascade)
  mittente      Utente        @relation(fields: [mittenteId], references: [id])

  @@map("messaggi")
}

// ============================================
// AI ASSISTANT
// ============================================

model ConversazioneAI {
  id       Int      @id @default(autoincrement())
  utenteId Int      @map("utente_id")
  contesto String   // e.g. "analisi_scheda", "suggerimento", "domanda_libera"
  creatoIl DateTime @default(now()) @map("creato_il")

  utente   Utente        @relation(fields: [utenteId], references: [id], onDelete: Cascade)
  messaggi MessaggioAI[]

  @@map("conversazioni_ai")
}

model MessaggioAI {
  id                Int      @id @default(autoincrement())
  conversazioneAiId Int      @map("conversazione_ai_id")
  ruolo             String   // "utente" or "assistente"
  contenuto         String
  inviatoIl         DateTime @default(now()) @map("inviato_il")

  conversazione ConversazioneAI @relation(fields: [conversazioneAiId], references: [id], onDelete: Cascade)

  @@map("messaggi_ai")
}

// ============================================
// PERSONAL TRAINER NOTICE BOARD
// ============================================

model AnnuncioPT {
  id              Int      @id @default(autoincrement())
  trainerId       Int      @map("trainer_id")
  destinatarioId  Int?     @map("destinatario_id")
  titolo          String
  contenuto       String
  priorita        String   @default("normale") // "normale", "importante", "urgente"
  creatoIl        DateTime @default(now()) @map("creato_il")

  trainer      Utente  @relation("AnnunciPT", fields: [trainerId], references: [id], onDelete: Cascade)
  destinatario Utente? @relation("AnnunciDestinatario", fields: [destinatarioId], references: [id], onDelete: SetNull)

  @@map("annunci_pt")
}

// ============================================
// WHAT'S NEW (in-app stories, managed by the admin)
// ============================================

model Novita {
  id           Int      @id @default(autoincrement())
  titolo       String
  sottotitolo  String?
  punti        String?  // JSON: [{ "icona": "💪", "testo": "..." }]
  icona        String?  // emoji for the header
  immagine     String?  // optional: header image (base64/url)
  ctaTesto     String?  @map("cta_testo")
  ctaRotta     String?  @map("cta_rotta")     // e.g. "/profilo"
  coloreInizio String?  @map("colore_inizio") // header gradient (hex)
  coloreFine   String?  @map("colore_fine")
  traduzioni   String?  // JSON: { "en": { "titolo", "sottotitolo", "punti", "ctaTesto" } }; the base fields are Italian
  attiva       Boolean  @default(true)
  ordine       Int      @default(0)
  creatoIl     DateTime @default(now()) @map("creato_il")

  @@map("novita")
}

// Body composition measurement (time series: smart scale)
model MisurazioneCorporea {
  id                    Int      @id @default(autoincrement())
  utenteId              Int      @map("utente_id")
  data                  DateTime @default(now())
  peso                  Float?
  bmi                   Float?
  grassoCorporeoPct     Float?   @map("grasso_corporeo_pct")
  muscoloScheletricoPct Float?   @map("muscolo_scheletrico_pct")
  massaMagraKg          Float?   @map("massa_magra_kg")
  grassoSottocutaneoPct Float?   @map("grasso_sottocutaneo_pct")
  grassoViscerale       Float?   @map("grasso_viscerale")
  acquaPct              Float?   @map("acqua_pct")
  massaMuscolareKg      Float?   @map("massa_muscolare_kg")
  massaOsseaKg          Float?   @map("massa_ossea_kg")
  proteinePct           Float?   @map("proteine_pct")
  bmr                   Int?
  etaMetabolica         Int?     @map("eta_metabolica")
  note                  String?
  inseritaDaPTId        Int?     @map("inserita_da_pt_id")
  creatoIl              DateTime @default(now()) @map("creato_il")

  utente Utente @relation("MisurazioniUtente", fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId, data])
  @@map("misurazioni_corporee")
}

// Workout put on the calendar for a specific day.
// We chose to store concrete occurrences instead of a recurrence rule: moving
// or postponing a single workout becomes a simple date change, with no
// exceptions to the rule to manage. The weekly distribution ("plan A on
// Monday, B on Wednesday, C on Friday, for 4 weeks") is expanded into
// occurrences by the scheduling service.
model AllenamentoPianificato {
  id         Int                         @id @default(autoincrement())
  utenteId   Int                         @map("utente_id")
  schedaId   Int                         @map("scheda_id")
  data       DateTime                    @db.Date
  stato      StatoAllenamentoPianificato @default(PIANIFICATO)
  creatoDaId Int?                        @map("creato_da_id")
  sessioneId Int?                        @unique @map("sessione_id")
  note       String?
  creatoIl   DateTime                    @default(now()) @map("creato_il")

  utente   Utente               @relation("AllenamentiPianificatiUtente", fields: [utenteId], references: [id], onDelete: Cascade)
  creatoDa Utente?              @relation("AllenamentiPianificatiCreatore", fields: [creatoDaId], references: [id], onDelete: SetNull)
  scheda   SchedaAllenamento    @relation(fields: [schedaId], references: [id], onDelete: Cascade)
  sessione SessioneAllenamento? @relation(fields: [sessioneId], references: [id], onDelete: SetNull)

  // The same plan twice on the same day for the same user makes no sense
  @@unique([utenteId, data, schedaId])
  @@index([utenteId, data])
  @@map("allenamenti_pianificati")
}

// In-app notification. Until now notifications existed only as a volatile
// socket event: whoever was not connected at that moment lost them. Storing
// them makes it possible to show them on return and to count the unread ones.
model AllenamentoNotifica {
  id        Int          @id @default(autoincrement())
  utenteId  Int          @map("utente_id")
  tipo      TipoNotifica @default(SISTEMA)
  titolo    String
  messaggio String
  // Internal path to open on tap (e.g. "/pianificazione"): no external URLs,
  // so a notification cannot take the user out of the app.
  percorso  String?
  letta     Boolean      @default(false)
  creatoIl  DateTime     @default(now()) @map("creato_il")

  utente Utente @relation(fields: [utenteId], references: [id], onDelete: Cascade)

  @@index([utenteId, letta])
  @@index([utenteId, creatoIl])
  @@map("notifiche")
}
